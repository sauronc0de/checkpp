{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "build.sh",
            "command": "${workspaceFolder}/scripts/build.sh",
            "type": "shell",
            "args": [
                "${command:cmake.buildTargetName}",
                "${command:cmake.activeConfigurePresetName}"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            }
        },
        {
            "label": "run.sh",
            "type": "shell",
            "command": "run.sh",
            "args": [
                "${command:cmake.activeConfigurePresetName}"
            ],
            "detail": "Build and run checkpp on itself",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        },
        {
            "label": "release.sh",
            "type": "shell",
            "command": "${workspaceFolder}/scripts/release.sh",
            "args": [],
            "detail": "Run the strict release workflow",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "presentation": {
                "reveal": "always",
                "panel": "shared",
                "clear": true
            },
            "problemMatcher": []
        }
    ]
}